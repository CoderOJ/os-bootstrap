network:
  version: 2
  renderer: networkd
  ethernets:
    enp5s0f0np0:
      link-local: []
    enp5s0f1np1:
      link-local: []
  bonds:
    bond0:
      interfaces:
        - enp5s0f0np0
        - enp5s0f1np1
      parameters:
        mode: 802.3ad
        lacp-rate: fast
        transmit-hash-policy: layer3+4
      dhcp4: true
