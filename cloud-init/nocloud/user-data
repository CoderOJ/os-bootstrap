#cloud-config

# Set locale and timezone
locale: en_US.UTF-8
timezone: Asia/Shanghai

# Configure users
users:
  - name: debian
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    # Add your SSH public key here for secure access
    # ssh_authorized_keys:
    #   - ssh-rsa AAAA...

# Disable SSH password authentication for security
ssh_pwauth: false

# Package update on first boot
package_update: true
package_upgrade: false

# Final message
final_message: "Cloud-init completed after $UPTIME seconds"
