#cloud-config

hostname: cscg-g30

# Set locale and timezone
locale: en_US.UTF-8
timezone: Asia/Shanghai

# Packages
package_update: false
package_upgrade: false
packages:
  - vim
  - fish
  - zsh
  - systemd-timesyncd
  - build-essential
  - git
  - sssd

# Configure users
users:
  - name: cscg
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: "$6$02Ds3srhFaTryBpG$d7Jq.SRBtKp4JCN0.TdhpI6zVh5G0aC1EWJ..efZvtUliO5XikLwPR0nCDd8LhNRQOJyMhFrJbRKMfQDHKjBB1"
    ssh_authorized_keys:
      - sk-ssh-ed25519@openssh.com AAAAGnNrLXNzaC1lZDI1NTE5QG9wZW5zc2guY29tAAAAIFnO4E0RKlwVUg8qSvPHac8CC4kGOHweIzoUPpPlFXDiAAAABHNzaDo= yzhang

# update /etc/hosts
manage_etc_hosts: true

# Disable SSH password authentication for security
ssh_pwauth: false

# Package update on first boot
package_update: true
package_upgrade: false

# Final message
final_message: "Cloud-init completed after $UPTIME seconds"

# Configure network using systemd-networkd
runcmd:
  - systemctl disable networking || true
  - systemctl enable --now systemd-networkd
  - systemctl enable --now systemd-resolved
  - btrfs quota enable /
  - btrfs quota rescan /
