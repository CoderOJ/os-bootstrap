#cloud-config

hostname: cscg-test

# Set locale and timezone
locale: en_US.UTF-8
timezone: Asia/Shanghai

# Packages
package_update: false
package_upgrade: false
packages:
  - vim
  - fish
  - netplan.io
  - systemd-resolved

# Configure users
users:
  - name: cscg
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: "$6$WNl4ux61UxjDajlg$WY1TbtyED8ed7ZnRWofp09oNJsaaRBdWhDKDb.P.qRqz5gE1zqNG929RC99vT6Ip.Fuhfbn/cpNQEW4zHOoZ00"
    # Add your SSH public key here for secure access
    # ssh_authorized_keys:
    #   - ssh-rsa AAAA...

# update /etc/hosts
manage_etc_hosts: true

# Disable SSH password authentication for security
ssh_pwauth: false

# Package update on first boot
package_update: true
package_upgrade: false

# Final message
final_message: "Cloud-init completed after $UPTIME seconds"

# Configure network using systemd-networkd
runcmd:
  - systemctl disable networking || true
  - systemctl enable --now systemd-networkd
  - systemctl enable --now systemd-resolved
