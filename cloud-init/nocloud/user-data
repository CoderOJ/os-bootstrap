#cloud-config

hostname: cscg-test

# Set locale and timezone
locale: en_US.UTF-8
timezone: Asia/Shanghai

# Packages
package_update: false
package_upgrade: false
packages:
  - vim
  - fish
  - netplan.io
  - systemd-resolved

# Configure users
users:
  - name: cscg
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: "$6$WNl4ux61UxjDajlg$WY1TbtyED8ed7ZnRWofp09oNJsaaRBdWhDKDb.P.qRqz5gE1zqNG929RC99vT6Ip.Fuhfbn/cpNQEW4zHOoZ00"
    # Add your SSH public key here for secure access
    # ssh_authorized_keys:
    #   - ssh-rsa AAAA...

# update /etc/hosts
manage_etc_hosts: true

# Disable SSH password authentication for security
ssh_pwauth: false

# Package update on first boot
package_update: true
package_upgrade: false

# Final message
final_message: "Cloud-init completed after $UPTIME seconds"

# Write netplan configuration
write_files:
  - path: /etc/netplan/01-netcfg.yaml
    content: |
      network:
        version: 2
        renderer: networkd
        ethernets:
          enp5s0f0np0:
            link-local: []
          enp5s0f1np1:
            link-local: []
        bonds:
          bond0:
            interfaces:
              - enp5s0f0np0
              - enp5s0f1np1
            parameters:
              mode: 802.3ad
              lacp-rate: fast
              transmit-hash-policy: layer3+4
            dhcp4: true

# Configure network using systemd-networkd
runcmd:
  - systemctl disable networking || true
  - systemctl enable --now systemd-networkd
  - systemctl enable --now systemd-resolved
  - netplan apply
